# Development tasks for gogram. Run `make` to list them.
#
# The telegram package is generated from the Bot API reference, which
# Telegram publishes only as HTML:
#
#   https://core.telegram.org/bots/api
#     -> internal/apispec/api.html   its documentation, snapshotted and checksummed
#                                    in internal/apispec/api.lock (make update-api)
#     -> *_gen.go                    parsed and generated by internal/cmd/genapi (make generate)
#
# Moving to a new Bot API version is `make update-api`.

STATICCHECK := honnef.co/go/tools/cmd/staticcheck@v0.8.2

# Files written by `make generate`.
GENERATED := telegram/*_gen.go telegram/*_gen_test.go update_gen.go update_gen_test.go sandbox/*_gen.go sandbox/*_gen_test.go

.DEFAULT_GOAL := help

.PHONY: help
help: ## List the tasks
	@awk 'BEGIN {FS = ":.*## "} /^[a-z-]+:.*## / {printf "  %-16s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

.PHONY: generate
generate: ## Generate the code from api.html (fails if it doesn't match api.lock)
	go generate ./...

.PHONY: update-api
update-api: ## Snapshot the Bot API reference, regenerate and test
	go run ./internal/cmd/fetchspec
	$(MAKE) generate test
	@echo
	@echo "Review the changes, e.g. git diff --stat, then commit internal/apispec and the generated files."

.PHONY: check-api
check-api: ## Fail if the Bot API reference changed since the snapshot
	go run ./internal/cmd/fetchspec -check

.PHONY: test
test: ## Run the tests with the race detector
	go test -race ./...

.PHONY: lint
lint: ## Run go vet, staticcheck and gofmt
	go vet ./...
	go run $(STATICCHECK) ./...
	@test -z "$$(gofmt -l .)" || { echo "gofmt needed:"; gofmt -l .; exit 1; }

.PHONY: check-generated
check-generated: generate ## Fail if the generated files are out of date with api.html and the generator
	@git diff --exit-code --stat -- $(GENERATED) || { echo "Generated files are out of date: run make generate and commit them."; exit 1; }
	@test -z "$$(git ls-files --others --exclude-standard -- $(GENERATED))" || { echo "New generated files are not committed:"; git ls-files --others --exclude-standard -- $(GENERATED); exit 1; }

.PHONY: check
check: lint test check-generated ## Everything CI should run
